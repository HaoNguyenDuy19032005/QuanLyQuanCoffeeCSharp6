@page "/login"
@inject HttpClient Http
@inject NavigationManager Navigation

<h3>Đăng nhập</h3>

<EditForm Model="@loginModel" OnValidSubmit="HandleLoginSubmit">
    <DataAnnotationsValidator />
    <ValidationSummary />

    <div class="form-group">
        <label for="phone">Số điện thoại</label>
        <InputText id="phone" class="form-control" @bind-Value="loginModel.PhoneNumber" />
    </div>

    <button type="submit" class="btn btn-primary">Tiếp tục</button>
</EditForm>

@if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="alert alert-danger mt-3">
        @errorMessage
    </div>
}

@code {
    private LoginModel loginModel = new LoginModel();
    private string errorMessage;

    private async Task HandleLoginSubmit()
    {
        if (string.IsNullOrEmpty(loginModel.PhoneNumber))
        {
            errorMessage = "Số điện thoại không được để trống!";
            return;
        }

        try
        {
            // Check if the phone number exists in the Employee API
           
            var customerResult = await Http.GetFromJsonAsync<Customer>($"https://localhost:5001/api/Customers/GetByPhoneNumber/{loginModel.PhoneNumber}");

            if (customerResult != null)
            {
                // If the phone number belongs to an employee, navigate to login-password page
                Navigation.NavigateTo($"/login-password/{loginModel.PhoneNumber}");
            }
            else
            {
                // If phone number is not found in Employee API, check if it belongs to a Customer
                var employeeResult = await Http.GetFromJsonAsync<Employee>($"http://localhost:5001/api/Employees/GetByPhoneNumber/{loginModel.PhoneNumber}");
                if (employeeResult != null)
                {
                    // If it's a Customer, navigate to login-password page
                    Navigation.NavigateTo($"/login-password/{loginModel.PhoneNumber}");
                }
                else
                {
                    // Display error if the phone number doesn't exist in both Employee and Customer
                    errorMessage = "Số điện thoại không tồn tại trong hệ thống!";
                }
            }
        }
        catch (Exception ex)
        {
            // Handle any errors that occur during the API calls
            errorMessage = $"Đã xảy ra lỗi khi kiểm tra số điện thoại: {ex.Message}";
        }
    }

    public class LoginModel
    {
        public string PhoneNumber { get; set; }
    }

    public class Employee
    {
        public int Id { get; set; }
        public string PhoneNumber { get; set; }
    }

    public class Customer
    {
        public int Id { get; set; }
        public string PhoneNumber { get; set; }
    }
}
