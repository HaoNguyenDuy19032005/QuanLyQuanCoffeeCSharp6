@page "/login-password/{PhoneNumber}"
@layout Layout.Login

@using CoffeeBlazor.Helpers
@inject HttpClient Http
@inject NavigationManager Navigation

<link href="~/css/Login.css" rel="stylesheet" />

<div class="login-container">
    <div class="login-image"></div>
    <div class="login-form">
        <!-- Icon trang chủ -->
        <a href="javascript:void(0)" class="home-icon" title="Trang chủ" @onclick="NavigateHome">
            <i class="fa-solid fa-house"></i>
        </a>

        <img src="/Img/AnhSanPham1.png" alt="Logo Lion" />

        <h1>Lion Xin Chào</h1>
        <h3>Đăng nhập cho số điện thoại</h3>
        <h4>Số điện thoại: @PhoneNumber</h4>

        <EditForm Model="@loginPasswordModel" OnValidSubmit="HandleLoginPasswordSubmit">
            <DataAnnotationsValidator />
            <ValidationSummary />

            <label for="password" style="color: rgb(0, 0, 0); font-weight: bold">Mật khẩu</label>
            <div class="password-wrapper">
                <InputText id="password" name="password" placeholder="Nhập mật khẩu*" @bind-Value="loginPasswordModel.Password" type="@passwordType" required />
                <i class="fa-solid @passwordIcon" @onclick="TogglePasswordVisibility"></i>
            </div>

            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <div class="alert alert-danger">
                    <p>@errorMessage</p>
                </div>
            }

            <button type="submit">Đăng Nhập</button>

            @if (invalidAttempts >= 5)
            {
                <div class="register-link text-center text-danger">
                    <p>*Nhập sai quá 5 lần sẽ bị khóa tài khoản</p>
                    <p>Vui lòng ấn "Quên mật khẩu" nếu cần lấy lại mật khẩu</p>
                </div>
            }

            <div class="register-link text-center">
                <a href="/Otp/ConfirmEmail" style="text-decoration:underline;">Bạn quên mật khẩu?</a>
            </div>
        </EditForm>
    </div>
</div>

@code {
    private LoginPasswordModel loginPasswordModel = new LoginPasswordModel();
    private string errorMessage;
    private string passwordType = "password";
    private string passwordIcon = "fa-eye-slash";  // Icon mật khẩu ẩn mặc định
    private int invalidAttempts = 0;  // Biến theo dõi số lần nhập sai mật khẩu

    [Parameter] public string PhoneNumber { get; set; }

    private async Task HandleLoginPasswordSubmit()
    {
        if (string.IsNullOrEmpty(loginPasswordModel.Password))
        {
            errorMessage = "Mật khẩu không được để trống!";
            return;
        }

        try
        {
            var customerResult = await Http.GetFromJsonAsync<Customer>($"https://localhost:5001/api/Customers/GetByPhoneNumber/{PhoneNumber}");
            if (customerResult != null)
            {
                var hashedPassword = HashHelper.ComputeSha256Hash(loginPasswordModel.Password);

                if (hashedPassword == customerResult.PassWord)
                {
                    Navigation.NavigateTo($"/home/customer/{PhoneNumber}");
                }
                else
                {
                    errorMessage = "Mật khẩu không chính xác!";
                    invalidAttempts++;  // Tăng số lần nhập sai
                }
            }
            else
            {
                var employeeResult = await Http.GetFromJsonAsync<Employee>($"https://localhost:5001/api/Employees/GetByPhoneNumber/{PhoneNumber}");

                if (employeeResult != null)
                {
                    var hashedPassword = HashHelper.ComputeSha256Hash(loginPasswordModel.Password);

                    if (hashedPassword == employeeResult.PassWord)
                    {
                        Navigation.NavigateTo("/home");
                    }
                    else
                    {
                        errorMessage = "Mật khẩu không chính xác!";
                        invalidAttempts++;  // Tăng số lần nhập sai
                    }
                }
                else
                {
                    errorMessage = "Số điện thoại không tồn tại trong hệ thống!";
                }
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Đã xảy ra lỗi khi xác thực mật khẩu: {ex.Message}";
        }
    }

    private void NavigateHome()
    {
        Navigation.NavigateTo("/home");
    }

    // Hàm để thay đổi type của mật khẩu và icon
    private void TogglePasswordVisibility()
    {
        if (passwordType == "password")
        {
            passwordType = "text";
            passwordIcon = "fa-eye";  // Hiển thị mắt
        }
        else
        {
            passwordType = "password";
            passwordIcon = "fa-eye-slash";  // Ẩn mắt
        }
    }

    public class LoginPasswordModel
    {
        public string Password { get; set; }
    }

    public class Employee
    {
        public int Id { get; set; }
        public string PhoneNumber { get; set; }
        public string PassWord { get; set; }
    }

    public class Customer
    {
        public int Id { get; set; }
        public string PhoneNumber { get; set; }
        public string PassWord { get; set; }
    }
}
