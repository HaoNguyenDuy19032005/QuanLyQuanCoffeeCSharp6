@page "/login-password/{PhoneNumber}"
@using CoffeeBlazor.Helpers
@inject HttpClient Http
@inject NavigationManager Navigation

<h3>Đăng nhập</h3>

<EditForm Model="@loginPasswordModel" OnValidSubmit="HandleLoginPasswordSubmit">
    <DataAnnotationsValidator />
    <ValidationSummary />

    <div class="form-group">
        <label for="password">Mật khẩu</label>
        <InputText id="password" class="form-control" @bind-Value="loginPasswordModel.Password" type="password" />
    </div>

    <button type="submit" class="btn btn-primary">Đăng nhập</button>
</EditForm>

@if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="alert alert-danger mt-3">
        @errorMessage
    </div>
}

@code {
    private LoginPasswordModel loginPasswordModel = new LoginPasswordModel();

    [Parameter] public string PhoneNumber { get; set; }

    private string errorMessage;

    private async Task HandleLoginPasswordSubmit()
    {
        if (string.IsNullOrEmpty(loginPasswordModel.Password))
        {
            errorMessage = "Mật khẩu không được để trống!";
            return;
        }

        try
        {
            // First, check if the phone number belongs to a Customer
            var customerResult = await Http.GetFromJsonAsync<Customer>($"https://localhost:5001/api/Customers/GetByPhoneNumber/{PhoneNumber}");

            if (customerResult != null)
            {
                // Hash the entered password
                var hashedPassword = HashHelper.ComputeSha256Hash(loginPasswordModel.Password);

                if (hashedPassword == customerResult.PassWord)
                {
                    // If valid, navigate to the Customer's Home page
                    Navigation.NavigateTo($"/home/customer/{PhoneNumber}");
                }
                else
                {
                    errorMessage = "Mật khẩu không chính xác!";
                }
            }
            else
            {
                // If not found in Customer API, check if it belongs to an Employee
                var employeeResult = await Http.GetFromJsonAsync<Employee>($"https://localhost:5001/api/Employees/GetByPhoneNumber/{PhoneNumber}");

                if (employeeResult != null)
                {
                    // Hash the entered password for Employee
                    var hashedPassword = HashHelper.ComputeSha256Hash(loginPasswordModel.Password);

                    if (hashedPassword == employeeResult.PassWord)
                    {
                        // If valid, navigate to the Employee's Home page
                        Navigation.NavigateTo("/home");
                    }
                    else
                    {
                        errorMessage = "Mật khẩu không chính xác!";
                    }
                }
                else
                {
                    errorMessage = "Số điện thoại không tồn tại trong hệ thống!";
                }
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Đã xảy ra lỗi khi xác thực mật khẩu: {ex.Message}";
        }
    }

    public class LoginPasswordModel
    {
        public string Password { get; set; }
    }

    public class Employee
    {
        public int Id { get; set; }
        public string PhoneNumber { get; set; }
        public string PassWord { get; set; }  // Hashed password
    }

    public class Customer
    {
        public int Id { get; set; }
        public string PhoneNumber { get; set; }
        public string PassWord { get; set; }  // Hashed password
    }
}
